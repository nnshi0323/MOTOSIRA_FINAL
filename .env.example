# Copy is created automatically by setup (tools/make_env.py). Never commit .env.
SECRET_KEY=
MOTOSIRA_USER=admin
MOTOSIRA_PASS=motosira123
# Optional: werkzeug password hash instead of the plain password above
MOTOSIRA_PASS_HASH=
# PC: localhost   |   Pi: the laptop's IPv4 address (./run_pi.sh ip <address>)
MOTOSIRA_BROKER=localhost
MOTOSIRA_BROKER_PORT=1883
MOTOSIRA_DEVICE_ID=pi-01
# Mode the dashboard opens in: mock (DEMO) or real
MOTOSIRA_DEFAULT_MODE=mock
# Optional: force a mic device (index or part of its name). Empty = auto-detect googlevoicehat.
MOTOSIRA_MIC_DEVICE=
MOTOSIRA_MIC_GAIN=1.0
# Optional Hall-effect RPM sensor on GPIO26 (pin 37): 1 = enabled
MOTOSIRA_RPM_ENABLED=0
